{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.aggrete/aggrete",
  "description": "An MCP proxy that enforces your code of conduct across connectors. Remembers what each user has seen and refuses the query that completes a forbidden picture, before it is fetched.",
  "repository": { "url": "https://github.com/aggrete/aggrete", "source": "github" },
  "version": "0.1.0",
  "websiteUrl": "https://aggrete.com",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "aggrete",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "named", "name": "--config", "description": "Path to proxy.config.yaml", "isRequired": true }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/aggrete/aggrete",
      "version": "0.1.0",
      "transport": { "type": "streamable-http", "url": "http://localhost:8080/mcp" }
    }
  ]
}
